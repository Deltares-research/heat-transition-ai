# Database connection for the warmteprogramma knowledge graph.
#
# Copy to secrets/db.env and fill in. That file is gitignored; this one is not,
# so never put real credentials here.
#
# Verify with:  python -m src.db.db_client

# ── Option 1: one URL (what the Azure portal gives you) ───────────────────────
#
# Portal → your server → Settings → Connect → "Connection string" (psycopg2/URI).
# sslmode=require is mandatory: Azure Flexible Server refuses plaintext.
#
# If the password contains @ : / ? or #, percent-encode it (@ becomes %40) or
# use Option 2 below, which needs no escaping.

DB_URL=postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/nplw?sslmode=require

# ── Option 2: discrete variables (no escaping needed) ─────────────────────────
#
# Used only when DB_URL is unset.
#
# PGHOST=SERVER.postgres.database.azure.com
# PGPORT=5432
# PGDATABASE=nplw
# PGUSER=USER
# PGPASSWORD=PASSWORD
# PGSSLMODE=require

# ── Notes ─────────────────────────────────────────────────────────────────────
#
# - Real environment variables override this file, so deployment settings win.
# - Azure blocks every client IP by default: Networking → Firewall rules → add
#   your address, or enable "Allow public access from Azure services".
# - For stricter certificate checking, download the Microsoft RSA root CA and
#   set sslmode=verify-full together with sslrootcert=/path/to/ca.pem. The
#   client leaves an explicit sslmode in the URL untouched.
