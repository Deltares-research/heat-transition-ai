# Azure Blob Storage for the warmteprogramma corpus.
#
# Copy to secrets/blob.env and fill in. That file is gitignored; this one is
# not, so never put a real key here.
#
# Verify with:  python -m src.blob.blob_client

# ── Option 1: connection string (what the portal gives you) ───────────────────
#
# Portal → storage account → Security + networking → Access keys →
# "Connection string" (show, then copy the whole line including EndpointSuffix).

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=ACCOUNT;AccountKey=KEY;EndpointSuffix=core.windows.net

# Container holding the corpus. Created on first use if absent.
AZURE_STORAGE_CONTAINER=nplw

# ── Option 2: account name + key ──────────────────────────────────────────────
#
# Used only when AZURE_STORAGE_CONNECTION_STRING is unset.
#
# AZURE_STORAGE_ACCOUNT=ACCOUNT
# AZURE_STORAGE_KEY=KEY

# ── Notes ─────────────────────────────────────────────────────────────────────
#
# - Real environment variables override this file, so deployment settings win.
# - Blob names mirror the local data/ tree: data/corpus/pdfs/almelo.pdf is
#   stored as corpus/pdfs/almelo.pdf.
# - If the storage account restricts public network access, add your client IP
#   under Networking before running anything.
# - Access keys grant full control of the account. For least privilege, issue a
#   container-scoped SAS instead and put it in the connection string as
#   BlobEndpoint=https://ACCOUNT.blob.core.windows.net;SharedAccessSignature=sv=...
