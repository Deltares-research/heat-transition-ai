# Azure AI Foundry embeddings (text-embedding-3-large).
#
# Copy to secrets/embedder.env and fill in. That file is gitignored; this one
# is not, so never put a real key here.
#
# Verify with:  python -m src.embedding

# Portal > Azure AI Foundry > your project > Deployments > your embedding
# deployment. "Target URI" gives the endpoint, "Key" gives the API key.

AZURE_EMBEDDING_ENDPOINT=https://RESOURCE.openai.azure.com/
AZURE_EMBEDDING_API_KEY=KEY
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_EMBEDDING_API_VERSION=2024-10-21

# Native width of text-embedding-3-large. The model also supports truncated
# output; lowering this shrinks what is stored in chunk_nodes.embedding.
EMBEDDING_DIMENSIONS=3072

# Texts per request. Chunks cap at ~3000 characters (~750 tokens), so 64 per
# call stays well inside the per-request token limit.
EMBEDDING_BATCH=64

# Retries for throughput throttling (HTTP 429), which Foundry applies per
# deployment TPM quota.
EMBEDDING_RETRIES=5

# Optional. Defaults to azure/<deployment>. Set this if your deployment is
# served through the Foundry models endpoint rather than Azure OpenAI, e.g.
# azure_ai/text-embedding-3-large
# EMBEDDING_MODEL=azure/text-embedding-3-large
